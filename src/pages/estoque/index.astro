---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import EmptyCatalog from '../../components/EmptyCatalog.astro';
import VehicleCard from '../../components/VehicleCard.astro';
import {visibleVehicles, dealership} from '../../lib/data';
import {path} from '../../lib/paths';
import {effectiveYear} from '../../lib/catalog';
const unique = (field: 'brand' | 'model' | 'transmission' | 'fuel' | 'body') => [...new Set(visibleVehicles.map(v => v[field]).filter(v => v !== null))].sort((a,b)=>a.localeCompare(b,'pt-BR'));
const options = [['brand','Marca'],['model','Modelo'],['transmission','Câmbio'],['fuel','Combustível'],['body','Carroceria']] as const;
const hasPrice = visibleVehicles.some(v => v.price !== null), hasYear = visibleVehicles.some(v => effectiveYear(v) !== null);
---
<Layout title="Estoque" description="Explore os veículos da Auto Cass. Busque por marca, modelo e versão, compare informações e conheça cada detalhe.">
 <section class="page-intro container"><p class="breadcrumb"><a href={path()}>Início</a><span>/</span>Estoque</p><div class="intro-row"><div><p class="eyebrow">Sua próxima escolha</p><h1>Explore o estoque.</h1></div><p>Encontre o que combina com você.<br/>Os detalhes estão em cada escolha.</p></div></section>
 <section class="inventory container" data-inventory>
  <div class="inventory-toolbar"><form class="inventory-search" data-search-form><label class="sr-only" for="inventory-search">Buscar marca, modelo ou versão</label><Icon name="search"/><input id="inventory-search" type="search" name="q" placeholder="Marca, modelo ou versão" maxlength="120"/><button type="submit" aria-label="Buscar veículos"><Icon/></button></form><button type="button" class="filter-open button button-outline" data-filter-open><Icon name="filter"/>Filtros<span data-filter-count></span></button><label class="sort-control">Ordenar por<select name="sort" data-sort><option value="default">Seleção do catálogo</option>{hasPrice && <><option value="price-asc">Menor preço</option><option value="price-desc">Maior preço</option></>}{hasYear && <><option value="year-desc">Ano mais novo</option><option value="year-asc">Ano mais antigo</option></>}</select></label></div>
  <div class="inventory-layout">
   <dialog class="filter-panel" data-filter-dialog aria-label="Filtros do estoque"><form data-filter-form><div class="filter-heading"><h2>Refine sua busca</h2><button type="button" class="icon-button filter-close" aria-label="Fechar filtros" data-filter-close><Icon name="close"/></button></div>{options.map(([key,label]) => unique(key).length > 0 && <label>{label}<select name={key}><option value="">Todos</option>{unique(key).map(value => <option value={value}>{value}</option>)}</select></label>)}{hasPrice && <fieldset><legend>Faixa de preço</legend><div class="filter-range"><label>De (R$)<input type="number" inputmode="numeric" min="0" name="minPrice" placeholder="Mínimo"/></label><label>Até (R$)<input type="number" inputmode="numeric" min="0" name="maxPrice" placeholder="Máximo"/></label></div></fieldset>}{hasYear && <fieldset><legend>Ano</legend><div class="filter-range"><label>De<input type="number" inputmode="numeric" min="1900" max={new Date().getFullYear()+2} name="minYear" placeholder="Mínimo"/></label><label>Até<input type="number" inputmode="numeric" min="1900" max={new Date().getFullYear()+2} name="maxYear" placeholder="Máximo"/></label></div></fieldset>}{visibleVehicles.length === 0 && <p class="filter-note">Os filtros estarão disponíveis quando o catálogo for confirmado.</p>}<button class="button button-dark" type="submit">Aplicar filtros <Icon/></button><button class="filter-reset" type="button" data-clear-filters>Limpar filtros</button></form></dialog>
   <div class="inventory-results"><div class="results-top"><p data-result-count aria-live="polite">{dealership.catalogStatus === 'awaiting-source' ? 'Catálogo em atualização' : `${visibleVehicles.length} veículos`}</p><div class="filter-chips" data-filter-chips></div></div><div class="vehicle-grid" data-vehicle-grid>{visibleVehicles.map(vehicle => <VehicleCard vehicle={vehicle}/>)}</div><div data-source-empty hidden={visibleVehicles.length > 0}><EmptyCatalog/></div><div data-filter-empty hidden><EmptyCatalog filtered/></div><nav class="pagination" aria-label="Páginas do estoque" data-pagination></nav><noscript><p class="noscript-note">Todos os veículos estão listados nesta página. Para usar a busca e os filtros, ative o JavaScript.</p></noscript></div>
  </div>
 </section>
 <script>
  import '../../scripts/inventory';
 </script>
 <script type="application/json" id="catalog-data" set:html={JSON.stringify(visibleVehicles).replace(/</g,'\\u003c')}/>
</Layout>
