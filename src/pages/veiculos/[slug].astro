---
import type {GetStaticPaths} from 'astro';
import type {Vehicle} from '../../lib/model';
import {vehicles, dealership, visibleVehicles} from '../../lib/data';
import {path, absolute} from '../../lib/paths';
import {money, kilometers, whatsappUrl} from '../../lib/catalog';
import {vehicleParts} from '../../lib/presentation';
import Layout from '../../layouts/Layout.astro';
import Gallery from '../../components/Gallery.astro';
import VehicleCard from '../../components/VehicleCard.astro';
import Icon from '../../components/Icon.astro';
export const getStaticPaths = (() => vehicles.map(vehicle => ({params:{slug:vehicle.slug},props:{vehicle}}))) satisfies GetStaticPaths;
interface Props {vehicle: Vehicle;}
const {vehicle: v} = Astro.props;
const parts = vehicleParts(v);
const image = v.photos.find(p => p.status === 'ready');
const unavailable = ['removed','unavailable'].includes(v.status);
const whatsapp = unavailable ? null : whatsappUrl(dealership.whatsapp,v.title,absolute(`veiculos/${v.slug}/`));
// Grouped so the sheet reads in two short blocks instead of one long ruled list.
const groups = [
 {title: 'Identificação', rows: [['Ano de fabricação',v.manufacturingYear],['Ano-modelo',v.modelYear],['Ano no anúncio',v.yearInTitle ?? null],['Cor',v.color],['Carroceria',v.body],['Portas',v.doors]]},
 {title: 'Mecânica e uso', rows: [['Quilometragem',kilometers(v.mileage)],['Câmbio',v.transmission],['Combustível',v.fuel],['Motorização',v.engine],...Object.entries(v.specifications)]},
].map(group => ({...group, rows: group.rows.filter(row => row[1] !== null)})).filter(group => group.rows.length > 0);
const sameBrand = visibleVehicles.filter(other => other.id !== v.id && (v.brand ? other.brand === v.brand : v.body ? other.body === v.body : false));
// Related: same brand first, then the nearest prices, so the block is never empty.
const nearest = visibleVehicles.filter(other => other.id !== v.id && !sameBrand.includes(other) && other.price !== null)
 .sort((a, b) => Math.abs(a.price! - (v.price ?? a.price!)) - Math.abs(b.price! - (v.price ?? b.price!)));
const related = [...sameBrand, ...nearest].slice(0, 3);
const structured = {
 '@context':'https://schema.org','@type':'Car',name:v.title,url:absolute(`veiculos/${v.slug}/`),
 ...(v.brand && {brand:{'@type':'Brand',name:v.brand}}),...(v.model && {model:v.model}),
 ...(v.modelYear && {vehicleModelDate:String(v.modelYear)}),...(v.manufacturingYear && {productionDate:String(v.manufacturingYear)}),
 ...(v.mileage!==null && {mileageFromOdometer:{'@type':'QuantitativeValue',value:v.mileage,unitCode:'KMT'}}),
 ...(image?.path && {image:absolute(image.path)}),...(v.color && {color:v.color}),
 ...(v.price!==null && !unavailable && {offers:{'@type':'Offer',price:v.price,priceCurrency:'BRL',url:absolute(`veiculos/${v.slug}/`),...(v.status==='available' && {availability:'https://schema.org/InStock'})}}),
};
---
<Layout page="veiculo" title={v.title} description={v.description?.slice(0,155) ?? `Conheça os detalhes de ${v.title} na Auto Cass. Consulte fotos, especificações e informações do anúncio.`} image={image?.path ?? undefined} noindex={unavailable}>
 {!dealership.demo && !unavailable && <script slot="head" type="application/ld+json" set:html={JSON.stringify(structured).replace(/</g,'\\u003c')}/>}
 <section class="vehicle-detail container" data-detail data-vehicle-id={v.id}>
  <div class="detail-heading">
   <p class="breadcrumb"><a href={path()}>Início</a><span aria-hidden="true">/</span><a href={path('estoque/')} data-inventory-return>Estoque</a><span aria-hidden="true">/</span><span>{parts.shortTitle}</span></p>
   <div class="detail-tools"><a class="back-link text-link" href={path('estoque/')} data-inventory-return>Voltar ao estoque</a><button class="text-link" type="button" data-share data-title={v.title}>Compartilhar <Icon name="share" size={18}/></button><span class="sr-only" aria-live="polite" data-share-status></span></div>
  </div>
  <div class="detail-grid">
   <div class="detail-title"><h1>{v.title}</h1></div>
   <div class="detail-gallery"><Gallery vehicle={v}/></div>
   <aside class="detail-summary" aria-label="Resumo e contato">
    <div class="detail-key-specs">
     {v.modelYear !== null ? <span>Ano-modelo <strong>{v.modelYear}</strong></span> : v.yearInTitle != null && <span>Ano no anúncio <strong>{v.yearInTitle}</strong></span>}
     {v.mileage !== null && <span>Quilometragem <strong>{kilometers(v.mileage)}</strong></span>}
     {v.transmission && <span>Câmbio <strong>{v.transmission}</strong></span>}
     {v.fuel && <span>Combustível <strong>{v.fuel}</strong></span>}
    </div>
    <p class="detail-price price">{money(v.price)}</p>
    {unavailable ? <div class="availability-note"><strong>Anúncio indisponível.</strong><p>Consulte o estoque para conhecer outros veículos. A indisponibilidade não confirma venda.</p><a href={path('estoque/')} class="button button-primary">Ver estoque <Icon/></a></div> : <>
     <p class="commercial-note">Confirme condições e disponibilidade com a equipe.</p>
     <a class="button button-primary button-block" href={whatsapp ?? path('contato/')} target={whatsapp ? '_blank' : undefined} rel={whatsapp ? 'noopener noreferrer' : undefined} data-track={whatsapp ? 'click_whatsapp' : undefined} data-position="vehicle-summary">{whatsapp ? 'Tenho interesse' : 'Ver canais de contato'}<Icon name="chat"/></a>
     {!whatsapp && <p class="contact-verification-note">WhatsApp aguardando confirmação.</p>}
    </>}
   </aside>
  </div>
  <div class="detail-body">
   <section class="detail-sheet" aria-labelledby="ficha">
    <h2 id="ficha" data-reveal="lines">Ficha técnica.</h2>
    {groups.length ? <div class="specifications">{groups.map(group => <div class="spec-group"><h3>{group.title}</h3><dl>{group.rows.map(([label,value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}</dl></div>)}</div> : <p>Consulte a ficha técnica com a equipe.</p>}
   </section>
   {v.description && <section aria-labelledby="sobre-veiculo"><h2 id="sobre-veiculo">Sobre este veículo.</h2><p class="vehicle-description">{v.description}</p></section>}
   {v.features.length > 0 && <section aria-labelledby="equipamentos"><h2 id="equipamentos" data-reveal="lines">Equipamentos.</h2><ul class="vehicle-features">{v.features.map(feature => <li><Icon name="check" size={16}/>{feature}</li>)}</ul></section>}
  </div>
 </section>
 {related.length > 0 && <section class="related container" aria-labelledby="relacionados"><div class="section-head"><h2 id="relacionados" data-reveal="lines">Continue explorando.</h2><a href={path('estoque/')} class="text-link">Ver estoque <Icon/></a></div><div class="vehicle-grid">{related.map(vehicle => <VehicleCard vehicle={vehicle}/>)}</div></section>}
 {whatsapp && <div class="mobile-interest"><span><small>Valor do anúncio</small><strong class="price">{money(v.price)}</strong></span><a href={whatsapp} class="button button-primary" target="_blank" rel="noopener noreferrer" data-track="click_whatsapp" data-position="vehicle-mobile">Tenho interesse <Icon name="chat"/></a></div>}
 <script>import '../../scripts/detail';</script>
</Layout>
