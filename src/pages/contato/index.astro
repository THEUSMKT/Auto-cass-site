---
import Layout from '../../layouts/Layout.astro';
import AddressLines from '../../components/AddressLines.astro';
import Icon from '../../components/Icon.astro';
import {dealership} from '../../lib/data';
import {whatsappUrl} from '../../lib/catalog';
import {path} from '../../lib/paths';
const whatsapp = whatsappUrl(dealership.whatsapp);
const hasContact = whatsapp || dealership.phone || dealership.email;
const maps = dealership.address ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(dealership.address)}` : null;
const socialIcons: Record<string, string> = {Instagram: 'instagram', Facebook: 'facebook', YouTube: 'youtube'};
---
<Layout page="contato" title="Contato" description="Fale com a Auto Cass pelo WhatsApp, telefone ou e-mail, ou visite a loja em Sapucaia do Sul.">
 <section class="page-intro container">
  <p class="breadcrumb"><a href={path()}>Início</a><span aria-hidden="true">/</span><span>Contato</span></p>
  <h1 data-reveal="lines">Fale com a Auto Cass.</h1>
  <p class="page-lead" data-reveal>Tire dúvidas sobre um veículo ou combine sua visita.</p>
 </section>
 <section class="contact-content container">
  <div class="contact-main">
   {hasContact ? <ul class="contact-options">
    {whatsapp && <li><a href={whatsapp} class="contact-option" target="_blank" rel="noopener noreferrer" data-track="click_whatsapp" data-reveal><Icon name="chat" size={28}/><span><small>Mais rápido</small><strong>WhatsApp</strong></span><Icon name="arrowUpRight"/></a></li>}
    {dealership.phone && <li><a class="contact-option" href={`tel:${dealership.phone.replace(/[^+0-9]/g,'')}`} data-track="click_phone" data-reveal><Icon name="phone" size={28}/><span><small>Telefone da loja</small><strong class="price">{dealership.phone}</strong></span><Icon name="arrowUpRight"/></a></li>}
    {dealership.email && <li><a class="contact-option" href={`mailto:${dealership.email}`} data-reveal><Icon name="envelope" size={28}/><span><small>E-mail</small><strong>{dealership.email}</strong></span><Icon name="arrowUpRight"/></a></li>}
   </ul> : <div class="contact-pending"><h2>Canais de contato em atualização.</h2><p>WhatsApp, telefone e endereço aparecem aqui após confirmação.</p><a href={dealership.sourceUrl} target="_blank" rel="noopener noreferrer" class="text-link">Consultar o site original <Icon size={16}/></a></div>}
  </div>
  <aside class="contact-aside" aria-labelledby="loja">
   <h2 id="loja" data-reveal>Loja</h2>
   {dealership.address ? <><address data-reveal><AddressLines address={dealership.address}/></address>{maps && <a class="text-link" href={maps} target="_blank" rel="noopener noreferrer">Como chegar <Icon name="arrowUpRight" size={18}/></a>}</> : <p>O endereço oficial será apresentado após confirmação.</p>}
   {dealership.hours.length > 0 && <div class="opening-hours"><h3>Horários de atendimento</h3>{dealership.hours.map(line => <p>{line}</p>)}</div>}
   {dealership.socials.length > 0 && <ul class="social-links">{dealership.socials.map(social => <li><a href={social.url} target="_blank" rel="noopener noreferrer"><Icon name={socialIcons[social.label] ?? 'arrowUpRight'} size={20}/>{social.label}</a></li>)}</ul>}
  </aside>
 </section>
</Layout>
