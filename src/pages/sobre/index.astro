---
import Layout from '../../layouts/Layout.astro';
import AddressLines from '../../components/AddressLines.astro';
import Icon from '../../components/Icon.astro';
import Picture from '../../components/Picture.astro';
import {dealership, vehicles} from '../../lib/data';
import {path} from '../../lib/paths';
import {whatsappUrl} from '../../lib/catalog';
const contact = whatsappUrl(dealership.whatsapp);
const showroom = vehicles.find(v => v.id === 'origem-home-07');
const showroomPhoto = showroom?.photos.find(p => p.status === 'ready');
const maps = dealership.address ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(dealership.address)}` : null;
---
<Layout page="sobre" title="Sobre" description="Conheça a Auto Cass, revenda de seminovos e 0 km em Sapucaia do Sul.">
 <section class="page-intro container">
  <p class="breadcrumb"><a href={path()}>Início</a><span aria-hidden="true">/</span><span>Sobre</span></p>
  <h1 data-reveal="lines">Auto Cass, em Sapucaia do Sul.</h1>
 </section>
 <section class="about container">
  {dealership.storeImage ? <img class="about-image" src={path(dealership.storeImage)} alt={`Loja da ${dealership.name}`} width="1600" height="1200"/> : showroomPhoto && showroom && <Picture class="about-image" photo={showroomPhoto} alt={`${showroom.title} no showroom da loja`} sizes="(max-width: 899px) 100vw, 58vw" priority/>}
  <div class="about-copy">
   <h2 data-reveal="lines">Conhecer os detalhes faz parte da escolha.</h2>
   <p data-reveal>{dealership.about ?? 'Esta é uma proposta de nova experiência digital para a Auto Cass: navegação simples, informações claras e espaço para conhecer cada veículo com calma.'}</p>
   {!dealership.verifiedAt && <p data-reveal>A história da loja será apresentada após confirmação nos canais oficiais.</p>}
   <a class="text-link" href={path('estoque/')} data-reveal>Ver estoque <Icon/></a>
  </div>
 </section>
 {dealership.address && <section class="about-visit container" aria-labelledby="visita">
  <h2 id="visita" data-reveal="lines">Onde estamos.</h2>
  <address data-reveal><AddressLines address={dealership.address}/></address>
  <div class="about-actions" data-reveal>
   {maps && <a class="button button-ghost" href={maps} target="_blank" rel="noopener noreferrer">Como chegar <Icon name="arrowUpRight"/></a>}
   {contact && <a class="button button-primary" href={contact} target="_blank" rel="noopener noreferrer" data-track="click_whatsapp" data-position="about">Fale com a equipe <Icon name="chat"/></a>}
  </div>
 </section>}
</Layout>
