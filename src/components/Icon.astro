---
// Phosphor Icons (light weight), inlined at build time. No runtime request, no hand-drawn paths.
import arrow from '@phosphor-icons/core/assets/light/arrow-right-light.svg?raw';
import arrowUpRight from '@phosphor-icons/core/assets/light/arrow-up-right-light.svg?raw';
import arrowUp from '@phosphor-icons/core/assets/light/arrow-up-light.svg?raw';
import search from '@phosphor-icons/core/assets/light/magnifying-glass-light.svg?raw';
import close from '@phosphor-icons/core/assets/light/x-light.svg?raw';
import menu from '@phosphor-icons/core/assets/light/list-light.svg?raw';
import plus from '@phosphor-icons/core/assets/light/plus-light.svg?raw';
import camera from '@phosphor-icons/core/assets/light/camera-light.svg?raw';
import filter from '@phosphor-icons/core/assets/light/funnel-simple-light.svg?raw';
import chevron from '@phosphor-icons/core/assets/light/caret-right-light.svg?raw';
import chevronLeft from '@phosphor-icons/core/assets/light/caret-left-light.svg?raw';
import expand from '@phosphor-icons/core/assets/light/corners-out-light.svg?raw';
import share from '@phosphor-icons/core/assets/light/share-network-light.svg?raw';
import pin from '@phosphor-icons/core/assets/light/map-pin-light.svg?raw';
import phone from '@phosphor-icons/core/assets/light/phone-light.svg?raw';
import chat from '@phosphor-icons/core/assets/light/whatsapp-logo-light.svg?raw';
import check from '@phosphor-icons/core/assets/light/check-light.svg?raw';
import envelope from '@phosphor-icons/core/assets/light/envelope-simple-light.svg?raw';
import instagram from '@phosphor-icons/core/assets/light/instagram-logo-light.svg?raw';
import facebook from '@phosphor-icons/core/assets/light/facebook-logo-light.svg?raw';
import youtube from '@phosphor-icons/core/assets/light/youtube-logo-light.svg?raw';

const icons: Record<string, string> = {arrow, arrowUpRight, arrowUp, search, close, menu, plus, camera, filter, chevron, chevronLeft, expand, share, pin, phone, chat, check, envelope, instagram, facebook, youtube};
interface Props { name?: string; size?: number; class?: string; }
const {name = 'arrow', size = 20, class: className} = Astro.props;
const inner = (icons[name] ?? icons.arrow).replace(/^<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '');
---
<svg class:list={['icon', className]} width={size} height={size} viewBox="0 0 256 256" fill="currentColor" aria-hidden="true" focusable="false" set:html={inner}/>
