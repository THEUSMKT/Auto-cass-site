---
import type {Vehicle} from '../lib/model';
import {money, kilometers} from '../lib/catalog';
import {vehicleParts} from '../lib/presentation';
import {path} from '../lib/paths';
import Icon from './Icon.astro';
import Picture from './Picture.astro';
interface Props {vehicle: Vehicle; priority?: boolean; class?: string; sizes?: string;}
const {vehicle: v, priority = false, class: className, sizes = '(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw'} = Astro.props;
const image = v.photos.find(p => p.status === 'ready');
const parts = vehicleParts(v);
const details = [parts.year, kilometers(v.mileage), v.transmission].filter(x => x !== null);
---
<article class:list={['vehicle-card', className]} data-vehicle-id={v.id}>
 <a href={path(`veiculos/${v.slug}/`)} class="vehicle-card-link" data-vehicle-link aria-label={`${v.title}, ${money(v.price)}`}>
  <div class="vehicle-card-image" data-cursor>
   {image?.path ? <Picture photo={image} alt={v.title} sizes={sizes} priority={priority} transitionName={`car-${v.id}`}/> : <div class="photo-unavailable"><Icon name="camera" size={28}/><span>Foto indisponível</span></div>}
  </div>
  <div class="vehicle-card-content">
   {parts.brand && <p class="vehicle-brand">{parts.brand}</p>}
   <h3>{parts.shortTitle}</h3>
   {details.length > 0 && <p class="vehicle-meta">{details.map(d => <span>{d}</span>)}</p>}
   <div class="vehicle-card-bottom"><strong class="price">{money(v.price)}</strong><span>Ver detalhes <Icon size={16}/></span></div>
  </div>
 </a>
</article>
