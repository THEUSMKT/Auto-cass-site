---
import '@fontsource-variable/geist/wght.css';
import '@fontsource-variable/geist/wght-italic.css';
import 'lenis/dist/lenis.css';
import '../styles/site.css';
import Icon from '../components/Icon.astro';
import { dealership } from '../lib/data';
import { path, absolute } from '../lib/paths';
import {whatsappUrl} from '../lib/catalog';
interface Props {title: string; description: string; image?: string; noindex?: boolean; page?: string;}
const {title, description, image, noindex = false, page = 'interna'} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const navigation = [['Estoque', 'estoque/'],['Sobre', 'sobre/'],['Contato','contato/']];
const contact = whatsappUrl(dealership.whatsapp);
const isDemo = dealership.demo || noindex;
const current = (url: string) => Astro.url.pathname === path(url) || (url === 'estoque/' && Astro.url.pathname.startsWith(path('veiculos/')));
const logo = dealership.logo ? path(dealership.logo) : null;
---
<!doctype html>
<html lang="pt-BR" class="no-js" data-page={page}>
 <head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <script is:inline>
   document.documentElement.classList.replace('no-js','js');
   // Failsafe: if the motion layer has not started after 2.5 s, show everything statically.
   setTimeout(function(){var r=document.documentElement;if(!r.classList.contains('motion-ready'))r.classList.add('motion-off');},2500);
  </script>
  <title>{title} | Auto Cass</title>
  <meta name="description" content={description}/>
  <meta name="theme-color" content="#202321"/>
  <meta name="color-scheme" content="dark"/>
  <meta name="robots" content={isDemo ? 'noindex, nofollow' : 'index, follow'}/>
  <link rel="canonical" href={canonical}/>
  <link rel="icon" type="image/svg+xml" href={path('favicon.svg')}/>
  <meta property="og:type" content="website"/>
  <meta property="og:locale" content="pt_BR"/>
  <meta property="og:title" content={`${title} | Auto Cass`}/>
  <meta property="og:description" content={description}/>
  <meta property="og:url" content={canonical}/>
  {image && <meta property="og:image" content={absolute(image)}/>}
  <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'}/>
  <slot name="head"/>
 </head>
 <body>
  <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
  <div class="masthead" data-masthead>
   {dealership.demo && <p class="demo-notice" data-demo-notice><span>Demonstração de redesign</span> · {dealership.catalogStatus === 'awaiting-source' ? 'Catálogo e contatos aguardando confirmação' : 'Confirme disponibilidade e valores com a loja'}</p>}
   <header class="site-header">
    <div class="container header-inner">
     <a href={path()} class="wordmark" aria-label="Auto Cass, início">{logo ? <img class="brand-logo" src={logo} alt="" width="150" height="79"/> : <span>Auto Cass</span>}</a>
     <nav class="desktop-nav" aria-label="Navegação principal">{navigation.map(([label,url]) => <a href={path(url)} aria-current={current(url) ? 'page' : undefined}>{label}</a>)}</nav>
     <a class="header-contact button button-ghost button-small" href={contact ?? path('contato/')} target={contact ? '_blank' : undefined} rel={contact ? 'noopener noreferrer' : undefined} data-track={contact ? 'click_whatsapp' : undefined}>Fale com a equipe</a>
     <button type="button" class="menu-toggle icon-button" aria-label="Abrir menu" data-menu-open><Icon name="menu" size={22}/></button>
    </div>
   </header>
  </div>
  <dialog class="mobile-menu" data-menu aria-label="Navegação">
   <div class="mobile-menu-top"><span class="wordmark">{logo ? <img class="brand-logo" src={logo} alt="Auto Cass" width="150" height="79"/> : 'Auto Cass'}</span><button class="icon-button" type="button" aria-label="Fechar menu" data-menu-close><Icon name="close" size={22}/></button></div>
   <nav aria-label="Navegação móvel"><a href={path()}>Início</a>{navigation.map(([label,url]) => <a href={path(url)}>{label}<Icon name="arrow"/></a>)}</nav>
   {contact && <a class="button button-primary button-block" href={contact} target="_blank" rel="noopener noreferrer" data-track="click_whatsapp">Fale com a equipe <Icon name="chat"/></a>}
  </dialog>
  <main id="conteudo" tabindex="-1"><slot/></main>
  <footer class="site-footer">
   <div class="container footer-grid">
    <a href={path()} class="wordmark footer-logo" aria-label="Auto Cass, início">{logo ? <img class="brand-logo" src={logo} alt="" width="150" height="79" loading="lazy"/> : 'Auto Cass'}</a>
    {dealership.address && <div class="footer-block"><h2 class="footer-label">Endereço</h2><address>{dealership.address}</address><a class="text-link" href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(dealership.address)}`} target="_blank" rel="noopener noreferrer">Como chegar <Icon name="arrowUpRight" size={16}/></a></div>}
    <div class="footer-block"><h2 class="footer-label">Atendimento</h2>{contact ? <a class="footer-whatsapp" href={contact} target="_blank" rel="noopener noreferrer" data-track="click_whatsapp"><Icon name="chat" size={20}/>WhatsApp</a> : <p>Canais em confirmação.</p>}{dealership.phone && <a href={`tel:${dealership.phone.replace(/[^+0-9]/g,'')}`} data-track="click_phone">{dealership.phone}</a>}</div>
    <nav class="footer-block" aria-label="Rodapé"><h2 class="footer-label">Navegue</h2>{navigation.map(([label,url]) => <a href={path(url)}>{label}</a>)}</nav>
   </div>
   <div class="container footer-bottom"><span>© {new Date().getFullYear()} Auto Cass</span>{dealership.demo && <span>Demonstração de redesign</span>}<a href="#conteudo" class="back-to-top" data-scroll-top>Voltar ao topo <Icon name="arrowUp" size={16}/></a></div>
  </footer>
  <div class="cursor-label" aria-hidden="true" data-cursor-label><span>Ver detalhes</span></div>
  <script>
   import '../scripts/global';
  </script>
 </body>
</html>
