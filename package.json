{
  "name": "auto-cass-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=9.6.5"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run validate:data && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "validate:data": "node scripts/validate-data.mjs",
    "test": "node --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "audit:source": "node scripts/audit-source.mjs",
    "import:review": "node scripts/import-catalog.mjs",
    "import:apply": "node scripts/import-catalog.mjs --apply"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "astro": "7.3.5",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "cheerio": "1.2.0",
    "sharp": "0.35.5",
    "typescript": "6.0.3"
  }
}
